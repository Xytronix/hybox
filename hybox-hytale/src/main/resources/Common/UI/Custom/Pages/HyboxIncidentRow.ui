$C = "../Common.ui";
$H = "HyboxTones.ui";
Group {
  LayoutMode: Top;
  Anchor: (Bottom: 2);
  Padding: (Top: 3, Bottom: 4);
  Group {
    LayoutMode: Left;
    Label #Key {
      Anchor: (Width: 260, Right: 12);
      Style: (FontSize: 12, TextColor: $H.@Text3, Wrap: true);
      TextTooltipStyle: $H.@TooltipStyle;
    }
    Label #Value {
      FlexWeight: 1;
      Style: (FontSize: 13, TextColor: $H.@Text, Wrap: true);
      TextTooltipStyle: $H.@TooltipStyle;
    }
  }
  $H.@Bar #Share {
    Anchor: (Left: 272, Height: 6, Top: 4);
    Visible: false;
  }
}
