$H = "HyboxTones.ui";
Group {
  LayoutMode: Left;
  Anchor: (Height: 24, Bottom: 6);
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@Series2; } Label { Text: "Engine"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@Series1; } Label { Text: "Mod"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@SeriesNeutral; } Label { Text: "JDK"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
}
