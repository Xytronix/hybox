$C = "../Common.ui";
$H = "HyboxTones.ui";

@TriggerRow = Group {
  LayoutMode: Left;
  Anchor: (Height: 56, Bottom: 2);
  Padding: (Horizontal: 10, Vertical: 7);

  $C.@CheckBox #CheckBox {
    Anchor: (Width: 22, Height: 22, Top: 9, Right: 12);
    Background: $H.@FrameBackground;
  }
  Group {
    LayoutMode: Top;
    FlexWeight: 1;
    Label {
      Text: @Name;
      Anchor: (Height: 21);
      Style: (FontSize: 13, TextColor: $H.@Text, RenderBold: true);
    }
    Label {
      Text: @Description;
      Anchor: (Height: 19);
      Style: (FontSize: 11, TextColor: $H.@Text3);
    }
  }
  Group #Thresholds {
    LayoutMode: Left;
    Anchor: (Width: 660, Height: 40);
  }
};

@NumberInput = Group {
  @Step = 1;
  LayoutMode: Left;
  Anchor: (Width: 220, Height: 38);

  Label {
    Text: @Label;
    Anchor: (Width: 126, Right: 4);
    Style: (FontSize: 12, TextColor: $H.@Text2, VerticalAlignment: Center);
  }
  $C.@NumberField #Input {
    @Anchor = (Width: 78, Right: 12);
    Background: $H.@FrameBackground;
    Style: (FontSize: 12, TextColor: $H.@Text);
    Format: (MaxDecimalPlaces: 0, Step: @Step);
  }
};
