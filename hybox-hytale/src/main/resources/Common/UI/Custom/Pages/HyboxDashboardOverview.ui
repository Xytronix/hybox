$C = "../Common.ui";
$H = "HyboxTones.ui";

Group {
  FlexWeight: 1;
  LayoutMode: TopScrolling;
  ScrollbarStyle: $C.@DefaultScrollbarStyle;

  Group #Warnings {
    LayoutMode: Left;
    Padding: (Horizontal: 14, Vertical: 10);
    Background: $H.@WarnBanner;
    Anchor: (Bottom: 10);
    Label #WarningTitle {
      Text: "Attention";
      Anchor: (Width: 105);
      Style: (FontSize: 12, TextColor: $H.@Warn, RenderBold: true, VerticalAlignment: Center);
    }
    Label #WarningText {
      FlexWeight: 1;
      Style: (FontSize: 12, TextColor: $H.@Warn, Wrap: true, WrapMaxLines: 3);
    }
  }

  Group #Tiles {
    LayoutMode: LeftWrap;
    Anchor: (Bottom: 14);
  }

  Label {
    Text: "Running now";
    Anchor: (Height: 26, Bottom: 4);
    Style: (RenderBold: true, FontSize: 17, TextColor: $H.@Text);
  }

  Group #ProfileRunning {
    LayoutMode: Top;
    Padding: (Horizontal: 15, Vertical: 12);
    Background: $H.@Panel;
    Anchor: (Bottom: 8);
    Group {
      LayoutMode: Left;
      Anchor: (Height: 36, Bottom: 10);
      Label {
        Text: "Detailed profile";
        FlexWeight: 1;
        Style: (RenderBold: true, FontSize: 14, TextColor: $H.@Text);
      }
      Group #ProfileTimerHost { Anchor: (Width: 150, Height: 36); }
    }
    $H.@Bar #ProfileProgress {
      @Anchor = (Bottom: 10);
      Value: 0;
    }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 32);
      Label #ProfileCaptureAt {
        FlexWeight: 1;
        Style: (FontSize: 12, TextColor: $H.@Text3, VerticalAlignment: Center);
      }
      Label #ProfileStopNote {
        Anchor: (Width: 330);
        Style: (FontSize: 11, TextColor: $H.@Text3, HorizontalAlignment: End, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 2);
        Visible: false;
      }
      $C.@SecondaryTextButton #ProfileSaveNow {
        @Text = "Save now";
        @Anchor = Anchor(Width: 140, Right: 8);
        Style: $H.@SecondaryButtonStyle;
      }
      $C.@SecondaryTextButton #ProfileCancel {
        @Text = "Cancel";
        @Anchor = Anchor(Width: 120);
        Style: $H.@SecondaryButtonStyle;
      }
    }
  }

  Group #ProfileSaving {
    LayoutMode: Left;
    Padding: (Horizontal: 15, Vertical: 12);
    Anchor: (Height: 60, Bottom: 8);
    Background: $H.@Panel;
    Visible: false;
    $C.@DefaultSpinner {}
    Label {
      Text: "Saving the profile bundle…";
      Anchor: (Left: 14);
      FlexWeight: 1;
      Style: (RenderBold: true, FontSize: 14, TextColor: $H.@Text, VerticalAlignment: Center);
    }
  }

  Group #CaptureRunning {
    LayoutMode: Left;
    Padding: (Horizontal: 15, Vertical: 12);
    Anchor: (Height: 84, Bottom: 8);
    Background: $H.@Panel;
    $C.@DefaultSpinner #CaptureSpinner {}
    Group {
      LayoutMode: Top;
      Anchor: (Left: 14);
      FlexWeight: 1;
      Label {
        Text: "Capturing incident";
        Anchor: (Height: 20);
        Style: (RenderBold: true, FontSize: 14, TextColor: $H.@Text);
      }
      Group {
        LayoutMode: Left;
        Anchor: (Height: 20, Top: 4);
        Label #CaptureStage0 {
          Text: "1 Queued";
          Anchor: (Width: 96, Right: 8);
          Style: (FontSize: 12, TextColor: $H.@Text3);
        }
        Label #CaptureStage1 {
          Text: "2 Collecting evidence";
          Anchor: (Width: 158, Right: 8);
          Style: (FontSize: 12, TextColor: $H.@Text3);
        }
        Label #CaptureStage2 {
          Text: "3 Waiting for the server to recover";
          FlexWeight: 1;
          Anchor: (Right: 8);
          Style: (FontSize: 12, TextColor: $H.@Text3);
        }
        Label #CaptureStage3 {
          Text: "4 Saving the recording";
          Anchor: (Width: 160, Right: 8);
          Style: (FontSize: 12, TextColor: $H.@Text3);
        }
        Label #CaptureStage4 {
          Text: "5 Building bundle";
          Anchor: (Width: 134);
          Style: (FontSize: 12, TextColor: $H.@Text3);
        }
      }
      Label #CaptureStep {
        Anchor: (Height: 20);
        Style: (FontSize: 12, TextColor: $H.@Text3);
        Visible: false;
      }
    }
    $C.@SecondaryTextButton #SkipWait {
      @Text = "Skip wait";
      @Anchor = Anchor(Width: 140, Left: 12);
      Style: $H.@SecondaryButtonStyle;
      Visible: false;
    }
  }

  Label #NothingRunning {
    Text: "No capture or profile session is running.";
    Anchor: (Height: 30);
    Style: (FontSize: 13, TextColor: $H.@Text3, VerticalAlignment: Center);
  }

  Group #ProfileStartPanel {
    LayoutMode: Top;
    Padding: (Horizontal: 15, Vertical: 12);
    Background: $H.@Panel;
    Anchor: (Bottom: 8);
    Label {
      Text: "Start a detailed profile";
      Anchor: (Height: 22);
      Style: (RenderBold: true, FontSize: 14, TextColor: $H.@Text);
    }
    Label #ProfileStartNote {
      Anchor: (Height: 20, Bottom: 8);
      Style: (FontSize: 12, TextColor: $H.@Text3, VerticalAlignment: Center);
    }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 44);
      Label {
        Text: "Duration";
        Anchor: (Width: 82);
        Style: (FontSize: 12, TextColor: $H.@Text2, VerticalAlignment: Center);
      }
      Group {
        LayoutMode: Top;
        Anchor: (Width: 92, Right: 6);
        $C.@SecondaryTextButton #ProfileMinutes1 { @Text = "1 min"; Anchor: (Height: 38, Top: 3); Padding: (Horizontal: 8); Style: $H.@SecondaryButtonStyle; }
        Group #ProfileMinutes1Marker { Anchor: (Height: 3); Background: $H.@Accent; Visible: false; }
      }
      Group {
        LayoutMode: Top;
        Anchor: (Width: 92, Right: 6);
        $C.@SecondaryTextButton #ProfileMinutes5 { @Text = "5 min"; Anchor: (Height: 38, Top: 3); Padding: (Horizontal: 8); Style: $H.@SecondaryButtonStyle; }
        Group #ProfileMinutes5Marker { Anchor: (Height: 3); Background: $H.@Accent; Visible: false; }
      }
      Group {
        LayoutMode: Top;
        Anchor: (Width: 92, Right: 6);
        $C.@SecondaryTextButton #ProfileMinutes15 { @Text = "15 min"; Anchor: (Height: 38, Top: 3); Padding: (Horizontal: 8); Style: $H.@SecondaryButtonStyle; }
        Group #ProfileMinutes15Marker { Anchor: (Height: 3); Background: $H.@Accent; Visible: false; }
      }
      Group {
        LayoutMode: Top;
        Anchor: (Width: 92, Right: 22);
        $C.@SecondaryTextButton #ProfileMinutes30 { @Text = "30 min"; Anchor: (Height: 38, Top: 3); Padding: (Horizontal: 8); Style: $H.@SecondaryButtonStyle; }
        Group #ProfileMinutes30Marker { Anchor: (Height: 3); Background: $H.@Accent; Visible: false; }
      }
      $C.@CheckBox #ProfileKeepBuffer {
        Anchor: (Width: 22, Height: 22, Top: 11, Right: 10);
        Background: $H.@FrameBackground;
        Value: true;
      }
      Label {
        Text: "Include the recording from before the start";
        FlexWeight: 1;
        Style: (FontSize: 12, TextColor: $H.@Text2, VerticalAlignment: Center);
      }
      $C.@TextButton #ProfileStartButton {
        @Text = "Start profile";
        @Anchor = Anchor(Width: 210);
        Style: $H.@PrimaryButtonStyle;
      }
    }
  }
}
