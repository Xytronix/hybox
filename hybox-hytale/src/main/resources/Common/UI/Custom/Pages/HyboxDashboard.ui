$C = "../Common.ui";
$H = "HyboxTones.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1180, Height: 690);

  #Title {
    Background: $H.@TitleBackground;
    Group {
      LayoutMode: Center;
      Anchor: (Full: 0);
      $H.@Logo #HeaderLogo { @Anchor = (Top: 1); }
      $C.@Title {
        @Text = "Hybox · Incident recorder";
        Padding: (Left: 10, Right: 19);
        Style: (...$C.@TitleStyle, TextColor: $H.@Text, HorizontalAlignment: Center);
      }
    }
    Group { Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 1); Background: $H.@Border; }
  }

  #Content {
    LayoutMode: Top;
    Background: $H.@PageBackground;

    Group {
      LayoutMode: Left;
      Anchor: (Height: 48, Bottom: 12);

      Group {
        LayoutMode: Top;
        Anchor: (Width: 180, Right: 8);
        $C.@SecondaryTextButton #OverviewButton { @Text = "Overview"; Style: $H.@TabButtonStyle; }
        Group #OverviewMarker { Anchor: (Height: 3, Top: 1); Background: $H.@Accent; }
      }
      Group {
        LayoutMode: Top;
        Anchor: (Width: 180, Right: 8);
        $C.@SecondaryTextButton #IncidentsButton { @Text = "Incidents"; Style: $H.@TabButtonStyle; }
        Group #IncidentsMarker { Anchor: (Height: 3, Top: 1); Background: $H.@Accent; Visible: false; }
      }
      Group {
        LayoutMode: Top;
        Anchor: (Width: 180, Right: 8);
        $C.@SecondaryTextButton #TriggersButton { @Text = "Triggers"; Style: $H.@TabButtonStyle; }
        Group #TriggersMarker { Anchor: (Height: 3, Top: 1); Background: $H.@Accent; Visible: false; }
      }
      Group {
        LayoutMode: Top;
        Anchor: (Width: 180);
        $C.@SecondaryTextButton #HeapButton { @Text = "Heap"; Style: $H.@TabButtonStyle; }
        Group #HeapMarker { Anchor: (Height: 3, Top: 1); Background: $H.@Accent; Visible: false; }
      }
    }

    Label #SectionTitle {
      Anchor: (Height: 25);
      Style: (RenderBold: true, FontSize: 20, TextColor: $H.@Text);
    }
    Label #SectionCaption {
      Anchor: (Height: 22, Bottom: 12);
      Style: (FontSize: 12, TextColor: $H.@Text3);
      Visible: false;
    }

    Group #Section { FlexWeight: 1; LayoutMode: Top; }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 32, Top: 6);
      Label #Feedback {
        FlexWeight: 1;
        Style: (FontSize: 12, TextColor: $H.@Text2, Wrap: true, WrapMaxLines: 1, VerticalAlignment: Center);
        Visible: false;
      }
      $C.@SecondaryTextButton #OpenLastButton {
        @Text = "Open incident";
        @Anchor = Anchor(Width: 160);
        Style: $H.@SecondaryButtonStyle;
        Visible: false;
      }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 58, Top: 12);
      $C.@TextButton #CaptureButton {
        @Text = "Capture incident";
        @Anchor = Anchor(Width: 200, Right: 8);
        Style: $H.@PrimaryButtonStyle;
      }
      Label #CaptureHint {
        FlexWeight: 1;
        Text: "Saves the last 15 minutes of recording and thread dumps as an incident bundle.";
        Style: (FontSize: 12, TextColor: $H.@Text3, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 3);
      }
      $C.@SecondaryTextButton #TrendsButton {
        @Text = "Trends";
        @Anchor = Anchor(Width: 120, Left: 12);
        Style: $H.@SecondaryButtonStyle;
      }
      $C.@SecondaryTextButton #SettingsButton {
        @Text = "Settings";
        @Anchor = Anchor(Width: 120, Left: 12, Right: 8);
        Style: $H.@SecondaryButtonStyle;
      }
      $C.@SecondaryTextButton #DismissButton {
        @Text = "Close";
        @Anchor = Anchor(Width: 120);
        Style: $H.@SecondaryButtonStyle;
      }
    }
  }
}
