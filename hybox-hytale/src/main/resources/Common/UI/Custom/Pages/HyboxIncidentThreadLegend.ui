$H = "HyboxTones.ui";
Group {
  LayoutMode: Left;
  Anchor: (Height: 24, Bottom: 6);
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@Good; } Label { Text: "RUNNABLE"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@Series2; } Label { Text: "WAITING"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@Series3; } Label { Text: "TIMED WAITING"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@Bad; } Label { Text: "BLOCKED"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@SeriesNeutral; } Label { Text: "No samples"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
}
