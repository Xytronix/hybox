$H = "HyboxTones.ui";
Group {
  LayoutMode: Left;
  Anchor: (Height: 24, Bottom: 6);
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@StateRunnable; } Label { Text: "Running"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@StateWaiting; } Label { Text: "Waiting"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@StateTimedWaiting; } Label { Text: "Timed waiting"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@StateBlocked; } Label { Text: "Blocked"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
  Group { LayoutMode: Left; Anchor: (Right: 14); Group { Anchor: (Width: 10, Height: 10, Top: 4, Right: 5); Background: $H.@FrameBackground; } Label { Text: "No samples"; Style: (FontSize: 11, TextColor: $H.@Text2); } }
}
