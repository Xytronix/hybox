$H = "HyboxTones.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 39, Bottom: 4);
  Padding: (Horizontal: 12, Vertical: 6);
  Background: $H.@Panel;
  Label #Trigger {
    Anchor: (Width: 190);
    Style: (FontSize: 13, TextColor: $H.@Text, VerticalAlignment: Center);
  }
  Group {
    LayoutMode: Left;
    Anchor: (Width: 118);
    Group #StatePill {
      LayoutMode: CenterMiddle;
      Anchor: (Width: 94, Height: 24, Top: 1);
      Background: $H.@NeutralPill;
      Label #Armed { Style: (FontSize: 10, RenderBold: true, TextColor: $H.@Good); }
    }
  }
  Label #Threshold {
    FlexWeight: 1;
    Style: (FontSize: 12, TextColor: $H.@Text2, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 2);
  }
}
