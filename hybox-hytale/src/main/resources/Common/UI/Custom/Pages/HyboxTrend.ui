$C = "../Common.ui";
$H = "HyboxTones.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1040, Height: 700);
  #Title {
    Background: $H.@TitleBackground;
    $C.@Title {
      @Text = "Hybox · Trends";
      Style: (...$C.@TitleStyle, TextColor: $H.@Text, HorizontalAlignment: Center);
    }
    Group { Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 1); Background: $H.@Border; }
  }
  #Content {
    LayoutMode: Top;
    Padding: (Full: 14);
    Background: $H.@PageBackground;
    Group {
      LayoutMode: Left;
      Anchor: (Height: 35, Bottom: 8);
      Label #RangeLabel { FlexWeight: 1; Style: (FontSize: 19, RenderBold: true, TextColor: $H.@Text, VerticalAlignment: Center); }
      Group {
        LayoutMode: Top;
        Anchor: (Width: 102, Right: 6);
        $C.@SecondaryTextButton #Range1 { @Text = "1 day"; Anchor: (Height: 32); Padding: (Horizontal: 8); Style: $H.@SecondaryButtonStyle; }
        Group #Range1Marker { Anchor: (Height: 3); Background: $H.@Accent; Visible: false; }
      }
      Group {
        LayoutMode: Top;
        Anchor: (Width: 102, Right: 6);
        $C.@SecondaryTextButton #Range7 { @Text = "7 days"; Anchor: (Height: 32); Padding: (Horizontal: 8); Style: $H.@SecondaryButtonStyle; }
        Group #Range7Marker { Anchor: (Height: 3); Background: $H.@Accent; Visible: false; }
      }
      Group {
        LayoutMode: Top;
        Anchor: (Width: 102);
        $C.@SecondaryTextButton #Range30 { @Text = "30 days"; Anchor: (Height: 32); Padding: (Horizontal: 8); Style: $H.@SecondaryButtonStyle; }
        Group #Range30Marker { Anchor: (Height: 3); Background: $H.@Accent; Visible: false; }
      }
    }
    Label #Summary { Anchor: (Height: 20, Bottom: 3); Style: (FontSize: 12, TextColor: $H.@Text2, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10); }
    Label #Unavailable { Anchor: (Height: 18, Bottom: 6); Style: (FontSize: 11, TextColor: $H.@Text3, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10); Visible: false; }
    Group #TrendScroll {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Label #EmptyState { Anchor: (Height: 56, Bottom: 8); Padding: (Full: 10); Background: $H.@Panel; Style: (FontSize: 13, TextColor: $H.@Text2, Wrap: true, WrapMaxLines: 2, VerticalAlignment: Center); Visible: false; }
      Group #Charts { LayoutMode: Top; }
    }
    Label #Feedback { Anchor: (Height: 22, Top: 6); Style: (FontSize: 12, TextColor: $H.@Text2, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10, VerticalAlignment: Center); TextTooltipStyle: $H.@TooltipStyle; }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 40, Top: 8);
      $C.@SecondaryTextButton #BackButton { @Text = "Back to dashboard"; Anchor: (Width: 208, Height: 38, Right: 8); Padding: (Horizontal: 10); Style: $H.@SecondaryButtonStyle; }
      $C.@SecondaryTextButton #SaveButton { @Text = "Save HTML report"; Anchor: (Width: 182, Height: 38, Right: 8); Padding: (Horizontal: 10); Style: $H.@SecondaryButtonStyle; }
      $C.@SecondaryTextButton #SettingsButton { @Text = "Open settings"; Anchor: (Width: 156, Height: 38, Right: 8); Padding: (Horizontal: 10); Visible: false; Style: $H.@SecondaryButtonStyle; }
      Group { FlexWeight: 1; }
      $C.@SecondaryTextButton #DismissButton { @Text = "Close"; Anchor: (Width: 130, Height: 38); Padding: (Horizontal: 10); Style: $H.@SecondaryButtonStyle; }
    }
  }
}
