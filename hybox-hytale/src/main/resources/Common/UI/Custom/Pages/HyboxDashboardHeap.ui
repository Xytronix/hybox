$C = "../Common.ui";

Group {
  LayoutMode: Top;
  FlexWeight: 1;

  Group {
    LayoutMode: Left;
    Anchor: (Height: 38, Bottom: 8);
    Label #HeapSummary {
      FlexWeight: 1;
      Style: (FontSize: 13, TextColor: #bfcdd5, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 2);
    }
    $C.@SecondaryTextButton #HeapWalkButton {
      @Text = "Walk heap";
      @Anchor = Anchor(Width: 170, Height: 38, Left: 12);
    }
  }

  Group #HeapConfirm {
    LayoutMode: Left;
    Padding: (Horizontal: 14, Vertical: 10);
    Background: #efbd62(0.10);
    Anchor: (Height: 62, Bottom: 8);
    Visible: false;
    Label {
      FlexWeight: 1;
      Text: "Walking the heap pauses the whole server, often for several seconds on large heaps. Players will notice the freeze.";
      Style: (FontSize: 12, TextColor: #efbd62, Wrap: true, WrapMaxLines: 2, VerticalAlignment: Center);
    }
    $C.@TextButton #HeapConfirmButton {
      @Text = "Walk now";
      @Anchor = Anchor(Width: 150, Height: 38, Left: 12, Right: 8);
    }
    $C.@SecondaryTextButton #HeapCancelButton {
      @Text = "Cancel";
      @Anchor = Anchor(Width: 120, Height: 38);
    }
  }

  Group #HeapWalking {
    LayoutMode: Left;
    Padding: (Horizontal: 15, Vertical: 12);
    Background: #7a9cc6(0.10);
    Anchor: (Height: 56, Bottom: 8);
    Visible: false;
    $C.@DefaultSpinner {}
    Label {
      Text: "Walking the heap…";
      Anchor: (Left: 14);
      FlexWeight: 1;
      Style: (RenderBold: true, FontSize: 14, TextColor: #d3e3ed, VerticalAlignment: Center);
    }
  }

  Group #HeapRows {
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
  }
}
