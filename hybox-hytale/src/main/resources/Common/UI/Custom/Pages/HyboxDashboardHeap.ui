$C = "../Common.ui";
$H = "HyboxTones.ui";

Group {
  LayoutMode: Top;
  FlexWeight: 1;

  Group {
    LayoutMode: Left;
    Anchor: (Height: 38, Bottom: 8);
    Label #HeapSummary {
      FlexWeight: 1;
      Style: (FontSize: 13, TextColor: $H.@Text2, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 2);
    }
    $C.@SecondaryTextButton #HeapWalkButton {
      @Text = "Walk heap";
      @Anchor = Anchor(Width: 170, Height: 38, Left: 12);
      Style: $H.@SecondaryButtonStyle;
    }
  }

  Group #HeapConfirm {
    LayoutMode: Left;
    Padding: (Horizontal: 14, Vertical: 10);
    Background: $H.@WarnBanner;
    Anchor: (Height: 62, Bottom: 8);
    Visible: false;
    Label {
      FlexWeight: 1;
      Text: "Walking the heap pauses the whole server, often for several seconds on large heaps. Players will notice the freeze.";
      Style: (FontSize: 12, TextColor: $H.@Warn, Wrap: true, WrapMaxLines: 2, VerticalAlignment: Center);
    }
    $C.@TextButton #HeapConfirmButton {
      @Text = "Walk now";
      @Anchor = Anchor(Width: 150, Height: 38, Left: 12, Right: 8);
      Style: $H.@PrimaryButtonStyle;
    }
    $C.@SecondaryTextButton #HeapCancelButton {
      @Text = "Cancel";
      @Anchor = Anchor(Width: 120, Height: 38);
      Style: $H.@SecondaryButtonStyle;
    }
  }

  Group #HeapWalking {
    LayoutMode: Left;
    Padding: (Horizontal: 15, Vertical: 12);
    Background: $H.@Panel;
    Anchor: (Height: 56, Bottom: 8);
    Visible: false;
    $C.@DefaultSpinner {}
    Label {
      Text: "Walking the heap...";
      Anchor: (Left: 14);
      FlexWeight: 1;
      Style: (RenderBold: true, FontSize: 14, TextColor: $H.@Text, VerticalAlignment: Center);
    }
  }

  Group #HeapRows {
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
  }
}
