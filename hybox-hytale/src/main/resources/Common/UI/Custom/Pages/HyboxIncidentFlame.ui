$C = "../Common.ui";
$H = "HyboxTones.ui";
@DefaultStyle = (Default: (Background: #bdb8ad), Hovered: (Background: #d1cdc4), Pressed: (Background: #bdb8ad), Sounds: $C.@ButtonSounds);
@EngineStyle = (Default: (Background: #6aa9e9), Hovered: (Background: #8dbdf0), Pressed: (Background: #6aa9e9), Sounds: $C.@ButtonSounds);
@ModStyle = (Default: (Background: #ffd21f), Hovered: (Background: #ffe066), Pressed: (Background: #ffd21f), Sounds: $C.@ButtonSounds);
@JdkStyle = (Default: (Background: #8f8a81), Hovered: (Background: #a29d93), Pressed: (Background: #8f8a81), Sounds: $C.@ButtonSounds);
Group {
  Button #Frame {
    LayoutMode: Left;
    Anchor: (Width: 100, Height: 23);
    Background: #bdb8ad;
    TextTooltipStyle: $H.@TooltipStyle;
    Style: @DefaultStyle;
    Label #FrameLabel { FlexWeight: 1; Padding: (Horizontal: 4); Style: (FontSize: 10, TextColor: $H.@OnAccent, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10); }
  }
}
