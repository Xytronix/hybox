$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1240, Height: 700);
  #Title { $C.@Title { @Text = "Incident"; } }
  #Content {
    LayoutMode: Top;
    Padding: (Full: 14);
    Group #IncidentHeader {
      Anchor: (Height: 80, Bottom: 10);
      LayoutMode: Top;
      Background: #ffffff(0.04);
      Padding: (Full: 10);
      Group {
        LayoutMode: Left;
        Anchor: (Height: 24, Bottom: 4);
        Label #Severity {
          Anchor: (Width: 112, Right: 10);
          Padding: (Horizontal: 8);
          Background: #ffffff(0.06);
          Style: (FontSize: 13, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: Center);
        }
        Label #Headline { FlexWeight: 1; Style: (FontSize: 17, RenderBold: true, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11); }
      }
      Label #IncidentMeta { Anchor: (Height: 18); Style: (FontSize: 12, TextColor: #bfcdd5, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9); }
      Label #BlockedIn { Anchor: (Height: 18); Style: (FontSize: 11, TextColor: #96a9be, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9); TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    }
    Group {
      LayoutMode: Left;
      FlexWeight: 1;
      Group #SectionNav {
        Anchor: (Width: 220, Right: 14);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Group {
          LayoutMode: Left;
          Anchor: (Height: 30, Bottom: 5);
          Label #SectionTitle { FlexWeight: 1; Style: (FontSize: 19, RenderBold: true, VerticalAlignment: Center); }
          Label #RecordingBadge { Anchor: (Width: 172); Style: (FontSize: 11, TextColor: #efbd62, HorizontalAlignment: End, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 8); }
        }
        Group #RangeControls {
          Anchor: (Height: 32, Bottom: 8);
          LayoutMode: Left;
        }
        Group #SectionScroll {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #Tiles { LayoutMode: LeftWrap; }
          Group #SectionBody { LayoutMode: Top; }
        }
        Group #Pagination {
          LayoutMode: Left;
          Anchor: (Height: 34, Top: 8);
          $C.@SecondaryTextButton #PagePrev { @Text = "Prev page"; Anchor: (Width: 132, Height: 32, Right: 8); Padding: (Horizontal: 8); }
          Label #PageStatus { FlexWeight: 1; Style: (FontSize: 12, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center); }
          $C.@SecondaryTextButton #PageNext { @Text = "Next page"; Anchor: (Width: 132, Height: 32); Padding: (Horizontal: 8); }
        }
      }
    }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 40, Top: 12);
      $C.@SecondaryTextButton #BackButton { @Text = "Back to incidents"; Anchor: (Width: 208, Height: 38, Right: 12); Padding: (Horizontal: 10); }
      Group { FlexWeight: 1; }
      $C.@SecondaryTextButton #DismissButton { @Text = "Close"; Anchor: (Width: 130, Height: 38); Padding: (Horizontal: 10); }
    }
  }
}
