$C = "../Common.ui";
$H = "HyboxTones.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1240, Height: 700);
  #Title {
    Background: $H.@TitleBackground;
    Group {
      LayoutMode: Center;
      Anchor: (Full: 0);
      $H.@Logo #HeaderLogo { @Anchor = (Top: 1); }
      $C.@Title {
        @Text = "Incident";
        Padding: (Left: 10, Right: 19);
        Style: (...$C.@TitleStyle, TextColor: $H.@Text, HorizontalAlignment: Center);
      }
    }
    Group { Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 1); Background: $H.@Border; }
  }
  #Content {
    LayoutMode: Top;
    Padding: (Full: 14);
    Background: $H.@PageBackground;
    Group #IncidentHeader {
      Anchor: (Height: 80, Bottom: 10);
      LayoutMode: Top;
      Background: $H.@Panel;
      Padding: (Full: 10);
      Group {
        LayoutMode: Left;
        Anchor: (Height: 24, Bottom: 4);
        Label #Severity {
          Anchor: (Width: 112, Right: 10);
          Padding: (Horizontal: 8);
          Background: $H.@NeutralPill;
          Style: (FontSize: 13, RenderBold: true, TextColor: $H.@Text2, VerticalAlignment: Center, HorizontalAlignment: Center);
        }
        Label #Headline { FlexWeight: 1; Style: (FontSize: 17, RenderBold: true, TextColor: $H.@Text, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 12); }
      }
      Label #IncidentMeta { Anchor: (Height: 18); Style: (FontSize: 12, TextColor: $H.@Text2, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10); TextTooltipStyle: $H.@TooltipStyle; }
      Label #BlockedIn { Anchor: (Height: 18); Style: (FontSize: 11, TextColor: $H.@Text3, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10); TextTooltipStyle: $H.@TooltipStyle; }
    }
    Group #CleanBanner {
      Anchor: (Height: 28, Bottom: 10);
      Padding: (Horizontal: 10);
      Background: $H.@WarnBanner;
      Visible: false;
      Label { Text: "Saved by an older Hybox. It can hold names and paths. Do not share the zip."; Anchor: (Full: 0); Style: (FontSize: 12, RenderBold: true, TextColor: $H.@Warn, VerticalAlignment: Center); }
    }
    Group {
      LayoutMode: Left;
      FlexWeight: 1;
      Group #SectionNav {
        Anchor: (Width: 220, Right: 14);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Group {
          LayoutMode: Left;
          Anchor: (Height: 30, Bottom: 5);
          Label #SectionTitle { FlexWeight: 1; Style: (FontSize: 19, RenderBold: true, TextColor: $H.@Text, VerticalAlignment: Center); }
          Label #RecordingBadge { Anchor: (Width: 260); Style: (FontSize: 11, TextColor: $H.@Info, HorizontalAlignment: End, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10); }
        }
        Group #RangeControls {
          Anchor: (Height: 33, Bottom: 8);
          LayoutMode: Left;
        }
        Group #SectionHost {
          FlexWeight: 1;
          LayoutMode: Top;
        }
        Group #Pagination {
          LayoutMode: Left;
          Anchor: (Height: 34, Top: 8);
          $C.@SecondaryTextButton #PagePrev { @Text = "Prev page"; Anchor: (Width: 132, Height: 32, Right: 8); Padding: (Horizontal: 8); Style: $H.@SecondaryButtonStyle; }
          Label #PageStatus { FlexWeight: 1; Style: (FontSize: 12, TextColor: $H.@Text3, HorizontalAlignment: Center, VerticalAlignment: Center); }
          $C.@SecondaryTextButton #PageNext { @Text = "Next page"; Anchor: (Width: 132, Height: 32); Padding: (Horizontal: 8); Style: $H.@SecondaryButtonStyle; }
        }
      }
    }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 40, Top: 12);
      $C.@SecondaryTextButton #BackButton { @Text = "Back to incidents"; Anchor: (Width: 208, Height: 38, Right: 12); Padding: (Horizontal: 10); Style: $H.@SecondaryButtonStyle; }
      Group { FlexWeight: 1; }
      $C.@SecondaryTextButton #DismissButton { @Text = "Close"; Anchor: (Width: 130, Height: 38); Padding: (Horizontal: 10); Style: $H.@SecondaryButtonStyle; }
    }
  }
}
