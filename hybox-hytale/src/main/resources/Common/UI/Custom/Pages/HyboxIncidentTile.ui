$H = "HyboxTones.ui";
Group {
  LayoutMode: Top;
  Anchor: (Width: 180, Height: 100, Right: 8, Bottom: 8);
  Padding: (Full: 10);
  Background: $H.@Panel;
  Label #Key { Anchor: (Height: 18); Style: (FontSize: 12, TextColor: $H.@Text3); }
  Label #Value { Anchor: (Height: 29); Style: (FontSize: 21, RenderBold: true, TextColor: $H.@Text, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 15); }
  Label #Sub { Anchor: (Height: 32); Style: (FontSize: 10, TextColor: $H.@Text2, Wrap: true); }
}
