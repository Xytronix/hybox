Group {
  LayoutMode: Top;
  Anchor: (Width: 205, Height: 90, Right: 8, Bottom: 8);
  Padding: (Full: 10);
  Background: #ffffff(0.06);
  Label #Key { Anchor: (Height: 18); Style: (FontSize: 11, TextColor: #96a9be, RenderUppercase: true); }
  Label #Value { Anchor: (Height: 29); Style: (FontSize: 23, RenderBold: true, TextColor: #ffffff); }
  Label #Sub { Anchor: (Height: 22); Style: (FontSize: 10, TextColor: #bfcdd5, Wrap: true); }
}
