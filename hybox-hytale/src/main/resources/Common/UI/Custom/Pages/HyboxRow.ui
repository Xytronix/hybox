$H = "HyboxTones.ui";

Button #IncidentRow {
  LayoutMode: Left;
  Anchor: (Height: 44, Bottom: 4);
  Padding: (Horizontal: 10, Vertical: 6);
  Style: (
    Default: (Background: $H.@Panel),
    Hovered: (Background: $H.@PanelHover),
    Pressed: (Background: $H.@Panel2)
  );

  Group {
    LayoutMode: Top;
    Anchor: (Width: 165);
    Label #Age {
      Anchor: (Height: 17);
      Style: (FontSize: 12, TextColor: $H.@Text, VerticalAlignment: Center);
    }
    Label #Time {
      Anchor: (Height: 15);
      Style: (FontSize: 11, TextColor: $H.@Text3, VerticalAlignment: Center);
    }
  }
  Group {
    LayoutMode: Left;
    Anchor: (Width: 100);
    Group #SeverityPill {
      Anchor: (Width: 84, Height: 24, Top: 4);
      Background: $H.@NeutralPill;
      Label #Severity { Anchor: (Full: 0); Style: (FontSize: 10, RenderBold: true, TextColor: $H.@Text2, HorizontalAlignment: Center, VerticalAlignment: Center); }
    }
  }
  Label #Trigger {
    Anchor: (Width: 160);
    Style: (FontSize: 11, TextColor: $H.@Text2, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 2);
  }
  Label #World {
    Anchor: (Width: 145, Right: 12);
    Style: (FontSize: 12, TextColor: $H.@Text2, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 2);
    TextTooltipStyle: $H.@TooltipStyle;
  }
  Label #Headline {
    FlexWeight: 1;
    Style: (FontSize: 12, TextColor: $H.@Text, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 2);
  }
  Group #CleanColumn {
    LayoutMode: Left;
    Anchor: (Width: 100, Left: 8);
    Visible: false;
    Group {
      Anchor: (Width: 92, Height: 24, Top: 4);
      Background: $H.@WarnPill;
      Label { Text: "Not cleaned"; Anchor: (Full: 0); Style: (FontSize: 10, RenderBold: true, TextColor: $H.@Warn, HorizontalAlignment: Center, VerticalAlignment: Center); }
    }
  }
}
