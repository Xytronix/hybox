$H = "HyboxTones.ui";

Group {
  LayoutMode: Top;
  Anchor: (Width: 368, Height: 116, Right: 8, Bottom: 8);
  Padding: (Horizontal: 14, Vertical: 11);
  Background: $H.@Panel;

  Group {
    LayoutMode: Left;
    Anchor: (Height: 21, Bottom: 4);
    Label #TileLabel {
      FlexWeight: 1;
      Style: (FontSize: 13, TextColor: $H.@Text3, RenderBold: true);
    }
    Group #SeverityPill {
      Anchor: (Width: 82, Height: 20);
      Background: $H.@NeutralPill;
      Label #Severity {
        Anchor: (Full: 0);
        Style: (FontSize: 10, RenderBold: true, TextColor: $H.@Text2, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
  }
  Label #TileValue {
    Anchor: (Height: 31, Bottom: 3);
    Style: (FontSize: 24, RenderBold: true, TextColor: $H.@Good);
  }
  Label #TileDetail {
    Style: (FontSize: 11, TextColor: $H.@Text3, Wrap: true, WrapMaxLines: 2);
    FlexWeight: 1;
  }
}
