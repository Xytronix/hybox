$C = "../Common.ui";
@SelectedStyle = (
  Default: (Background: #ffffff(0.08), LabelStyle: (FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.08), LabelStyle: (FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.06), LabelStyle: (FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);
@DefaultStyle = (
  Default: (Background: #ffffff(0.04), LabelStyle: (FontSize: 12, TextColor: #bfcdd5, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Hovered: (Background: #ffffff(0.08), LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Pressed: (Background: #ffffff(0.06), LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);
$C.@SecondaryTextButton #Button {
  @Text = "";
  Anchor: (Height: 24, Bottom: 2);
  Padding: (Horizontal: 10);
  TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  Style: @DefaultStyle;
}
