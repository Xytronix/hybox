$C = "../Common.ui";
$H = "HyboxTones.ui";
@SelectedStyle = (
  Default: (Background: $H.@AccentTint, LabelStyle: (FontSize: 12, RenderBold: true, TextColor: $H.@Accent, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Hovered: (Background: $H.@AccentTint, LabelStyle: (FontSize: 12, RenderBold: true, TextColor: $H.@Accent, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Pressed: (Background: $H.@AccentTint, LabelStyle: (FontSize: 12, RenderBold: true, TextColor: $H.@Accent, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);
@DefaultStyle = (
  Default: (Background: $H.@Bg2, LabelStyle: (FontSize: 12, TextColor: $H.@Text2, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Hovered: (Background: $H.@PanelHover, LabelStyle: (FontSize: 12, TextColor: $H.@Text, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Pressed: (Background: $H.@Panel2, LabelStyle: (FontSize: 12, TextColor: $H.@Text, HorizontalAlignment: Start, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);
$C.@SecondaryTextButton #Button {
  @Text = "";
  Anchor: (Height: 24, Bottom: 2);
  Padding: (Horizontal: 10);
  TextTooltipStyle: $H.@TooltipStyle;
  Style: @DefaultStyle;
}
