$C = "../Common.ui";
$H = "HyboxTones.ui";
Group {
  LayoutMode: Left;
  Anchor: (Bottom: 8);
  Label #Evidence {
    FlexWeight: 1;
    Anchor: (Right: 12);
    Style: (FontSize: 13, TextColor: $H.@Text, Wrap: true);
    TextTooltipStyle: $H.@TooltipStyle;
  }
  $C.@SmallSecondaryTextButton #EvidenceLink {
    @Text = "";
    Anchor: (Width: 200, Height: 28);
    Padding: (Horizontal: 8);
    TextTooltipStyle: $H.@TooltipStyle;
    Style: $H.@LinkButtonStyle;
  }
}
