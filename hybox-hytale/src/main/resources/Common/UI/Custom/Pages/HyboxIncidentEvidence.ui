$C = "../Common.ui";
Group {
  LayoutMode: Left;
  Anchor: (Bottom: 8);
  Label #Evidence {
    FlexWeight: 1;
    Anchor: (Right: 12);
    Style: (FontSize: 13, TextColor: #ffffff(0.92), Wrap: true);
  }
  $C.@SmallSecondaryTextButton #EvidenceLink {
    @Text = "";
    Anchor: (Width: 145, Height: 28);
    Padding: (Horizontal: 8);
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }
}
