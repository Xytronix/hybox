$C = "../Common.ui";
$H = "HyboxTones.ui";

Group {
  LayoutMode: Top;
  FlexWeight: 1;

  Group {
    LayoutMode: Left;
    Anchor: (Height: 34, Bottom: 6);
    Label #IncidentFilter {
      FlexWeight: 1;
      Style: (FontSize: 12, TextColor: $H.@Text2, VerticalAlignment: Center);
    }
    $C.@SecondaryTextButton #ManualToggle {
      @Text = "Show manual captures";
      @Anchor = Anchor(Width: 240, Height: 32);
      Style: $H.@SecondaryButtonStyle;
      Visible: false;
    }
  }

  Group {
    LayoutMode: Left;
    Anchor: (Height: 30, Bottom: 5);
    Padding: (Horizontal: 10);
    Background: $H.@Panel2;
    Label { Text: "Time"; Anchor: (Width: 165); Style: (FontSize: 12, TextColor: $H.@Text3, RenderBold: true, VerticalAlignment: Center); }
    Label { Text: "Severity"; Anchor: (Width: 100); Style: (FontSize: 12, TextColor: $H.@Text3, RenderBold: true, VerticalAlignment: Center); }
    Label { Text: "Trigger"; Anchor: (Width: 160); Style: (FontSize: 12, TextColor: $H.@Text3, RenderBold: true, VerticalAlignment: Center); }
    Label { Text: "World"; Anchor: (Width: 145, Right: 12); Style: (FontSize: 12, TextColor: $H.@Text3, RenderBold: true, VerticalAlignment: Center); }
    Label { Text: "Headline"; FlexWeight: 1; Style: (FontSize: 12, TextColor: $H.@Text3, RenderBold: true, VerticalAlignment: Center); }
  }
  Label #IncidentEmpty {
    Anchor: (Height: 42);
    Style: (FontSize: 13, TextColor: $H.@Text3, VerticalAlignment: Center);
    Visible: false;
  }
  Group #IncidentRows {
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
  }
}
