$H = "HyboxTones.ui";
Group {
  LayoutMode: Top;
  Anchor: (Bottom: 3);
  Padding: (Horizontal: 10, Top: 6, Bottom: 7);
  Background: $H.@Panel;
  Group {
    LayoutMode: Left;
    Label #Name { Anchor: (Width: 350, Right: 12); Style: (FontSize: 12, TextColor: $H.@Text, Wrap: true); }
    Label #Facts { Anchor: (Width: 290, Right: 12); Style: (FontSize: 11, TextColor: $H.@Text2, Wrap: true); }
    Label #Amount { FlexWeight: 1; Style: (FontSize: 12, RenderBold: true, TextColor: $H.@Text, Wrap: true, HorizontalAlignment: End); }
  }
  $H.@Bar #Share {
    Anchor: (Width: 350, Height: 6, Top: 5);
    Visible: false;
  }
  Label #Details { Anchor: (Top: 4); Style: (FontSize: 11, TextColor: $H.@Text3, Wrap: true); }
}
