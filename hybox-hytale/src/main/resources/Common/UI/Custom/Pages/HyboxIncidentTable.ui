$C = "../Common.ui";
Group {
  LayoutMode: Top;
  Anchor: (Bottom: 3);
  Padding: (Horizontal: 10, Top: 6, Bottom: 7);
  Background: #1a1a1a(0.3);
  Group {
    LayoutMode: Left;
    Label #Name { Anchor: (Width: 350, Right: 12); Style: (FontSize: 12, TextColor: #ffffff, Wrap: true); TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    Label #Facts { Anchor: (Width: 290, Right: 12); Style: (FontSize: 11, TextColor: #bfcdd5, Wrap: true); }
    Label #Amount { FlexWeight: 1; Style: (FontSize: 12, TextColor: #7a9cc6, Wrap: true, HorizontalAlignment: End); }
  }
  Label #Details { Anchor: (Top: 4); Style: (FontSize: 11, TextColor: #96a9be, Wrap: true); TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
}
