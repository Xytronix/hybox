$C = "../Common.ui";
$H = "../Pages/HyboxTones.ui";

Group {
  Anchor: (Left: 20, Top: 80, Height: 72);
  LayoutMode: Left;

  Group #Profile {
    Background: $H.@HudBackground;
    Padding: (Horizontal: 14, Vertical: 8);
    LayoutMode: Left;
    Visible: false;

    Group {
      Anchor: (Width: 56, Height: 56, Right: 12);
      $C.@CircularProgressBar #Ring {
        @Size = 56;
        Value: 0;
        Background: $H.@Border;
        Color: $H.@Accent;
      }
    }

    Group {
      LayoutMode: Top;
      Anchor: (Width: 150);
      Label {
        Text: "Hybox profile";
        Anchor: (Height: 18);
        Style: (FontSize: 12, RenderBold: true, TextColor: $H.@Text2);
      }
      Group #TimerHost { Anchor: (Height: 32); }
    }
  }

  Group #Capture {
    Background: $H.@HudBackground;
    Padding: (Horizontal: 14, Vertical: 8);
    LayoutMode: Left;
    Visible: false;

    $C.@DefaultSpinner { @Anchor = (Right: 12, Top: 4); }

    Group {
      LayoutMode: Top;
      Anchor: (Width: 260);
      Label {
        Text: "Hybox capture";
        Anchor: (Height: 18);
        Style: (FontSize: 12, RenderBold: true, TextColor: $H.@Text2);
      }
      Label #Step {
        Anchor: (Height: 22);
        Style: (FontSize: 14, TextColor: $H.@Text, VerticalAlignment: Center);
      }
    }
  }
}
